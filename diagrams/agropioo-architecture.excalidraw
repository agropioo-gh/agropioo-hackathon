{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "rectangle",
      "id": "title",
      "x": 50,
      "y": 20,
      "width": 700,
      "height": 60,
      "backgroundColor": "#1a1a2e",
      "strokeColor": "#c5c6c7",
      "fillStyle": "solid",
      "rounding": 8,
      "text": "Agropioo - AI Agriculture Advisor",
      "fontFamily": 5,
      "fontSize": 20,
      "color": "#f0f0f0"
    },
    {
      "type": "rectangle",
      "id": "user",
      "x": 50,
      "y": 120,
      "width": 150,
      "height": 80,
      "backgroundColor": "#e8f5e9",
      "strokeColor": "#2d7a32",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "Farmer\n\n• Selects language\n• Views dashboard\n• Uploads photos\n• Asks advisor\n• Logs activities",
      "fontFamily": 5,
      "fontSize": 12,
      "color": "#1b5e20"
    },
    {
      "type": "rectangle",
      "id": "frontend",
      "x": 230,
      "y": 100,
      "width": 200,
      "height": 120,
      "backgroundColor": "#1f1f33",
      "strokeColor": "#4f5155",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "Next.js 16\n\nReact 19\n\nServer Components\n\nRoute Handlers\n\n66 API Endpoints\n\nTailwind CSS v4",
      "fontFamily": 5,
      "fontSize": 11,
      "color": "#d1d1d6"
    },
    {
      "type": "rectangle",
      "id": "ai_agents",
      "x": 460,
      "y": 100,
      "width": 180,
      "height": 130,
      "backgroundColor": "#311b92",
      "strokeColor": "#7b1fa2",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "AI Agent System\n\n@openai/agents\n\n8 Specialized Agents:\n\n1. Triage\n2. Crop Advisor\n3. Weather Agent\n4. Prices Agent\n5. Schemes Agent\n6. Farm Data Agent\n7. Crop Rec. Agent\n8. Handoff Agent\n\nRAG: pgvector + Ollama\n\nStreaming (SSE)\n\nGuardrails",
      "fontFamily": 5,
      "fontSize": 11,
      "color": "#ce93d8"
    },
    {
      "type": "rectangle",
      "id": "db",
      "x": 50,
      "y": 230,
      "width": 180,
      "height": 140,
      "backgroundColor": "#0d47a1",
      "strokeColor": "#1565c0",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "Neon Lakebase Postgres\n\npgvector Extension\n\nTables & Relationships\n\n16 Migrations\n\nTranslations (8 langs)",
      "fontFamily": 5,
      "fontSize": 11,
      "color": "#1976d2"
    },
    {
      "type": "rectangle",
      "id": "external",
      "x": 460,
      "y": 250,
      "width": 180,
      "height": 150,
      "backgroundColor": "#6a1b9a",
      "strokeColor": "#8e24aa",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "External Services\n\n• OpenWeather API\n  → 5-day forecast\n• 5 Gov Price Scrapers\n  → AMIS, SAMIS, FMIS-KP, BMIS, PBS-SPI\n• Cloudinary\n  → Disease scan images\n• HuggingFace API\n  → Disease classification\n• Photon API\n  → Geocoding\n• SMTP (Nodemailer)\n  → OTP/Notifications",
      "fontFamily": 5,
      "fontSize": 11,
      "color": "#ab47bc"
    },
    {
      "type": "rectangle",
      "id": "pwa",
      "x": 50,
      "y": 390,
      "width": 180,
      "height": 100,
      "backgroundColor": "#006064",
      "strokeColor": "#008394",
      "fillStyle": "solid",
      "rounding": 6,
      "text": "PWA / Offline-First\n\nSerwist Service Worker\n\nIndexedDB Write Queue\n\nClient UUIDs (idempotency)\n\nOffline Install (Android/iOS)",
      "fontFamily": 5,
      "fontSize": 11,
      "color": "#008394"
    },
